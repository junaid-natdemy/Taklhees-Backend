# Backend Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO REPOSITORY

# Django Core
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=dev-insecure-secret-key-takhlees-change-in-production-123456789
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_NAME=takhlees_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SimpleJWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Media & Storage (AWS S3 or Local)
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=me-central-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# CRM / HRMS Lead Integration
CRM_API_ENDPOINT=https://api.crm-example.com/v1/leads
CRM_API_TOKEN=
CRM_SYNC_ENABLED=False
